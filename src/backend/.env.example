# VIGILANCE Backend Configuration
# Copy this file to .env and adjust values for your environment
# NEVER commit .env to version control

# Database
DATABASE_URL=sqlite:///./vigilance.db

# Storage paths (relative to backend/ directory)
EVIDENCE_STORAGE_PATH=../evidence_storage
REPORTS_PATH=../generated_reports
SAMPLE_DATA_PATH=../sample_data

# Security
MAX_FILE_SIZE_MB=100
ALLOWED_EXTENSIONS=[".csv", ".json", ".log", ".txt"]

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Logging
LOG_LEVEL=INFO
